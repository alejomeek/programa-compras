# Configuracion del Programa de Compras.
# Copia este archivo a .env.local y completa los valores del proyecto de
# Supabase. .env.local NUNCA se sube a Git (ver .gitignore).
#
# Estas dos variables son publicas por diseno: viajan al navegador y quien
# autoriza de verdad es RLS en Postgres.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Fase 2: variables de SOLO SERVIDOR. Nunca "NEXT_PUBLIC_*", nunca llegan al
# navegador. Las usa api/imports_process.py (funcion Python de Vercel) para
# procesar importaciones con privilegios de service_role.
# ---------------------------------------------------------------------------

# Clave de servicio del proyecto Supabase. Omite RLS: solo la usa el servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Cadena de conexion Postgres de servicio (para psycopg), no la URL HTTP.
SUPABASE_DB_URL=

# Secreto compartido entre src/app/api/imports/route.ts y
# api/imports_process.py: sin el, esa funcion no procesa nada. Genera un
# valor propio (ej. `openssl rand -hex 32`), nunca uses un valor de ejemplo.
INTERNAL_API_SECRET=
