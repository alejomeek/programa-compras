# Configuracion del Programa de Compras.
# Copia este archivo a .env.local y completa los valores del proyecto de
# Supabase. .env.local NUNCA se sube a Git (ver .gitignore).
#
# Estas dos variables son publicas por diseno: viajan al navegador y quien
# autoriza de verdad es RLS en Postgres.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# La clave `service_role` NO se declara aqui: omite RLS y solo puede existir
# como variable de entorno del servidor, a partir de la Fase 2.
